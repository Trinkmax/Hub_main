{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!.next",
      "!node_modules",
      "!components/ui-legacy",
      "!components/legacy",
      "!supabase/.branches",
      "!supabase/.temp",
      "!coverage",
      "!types/database.ts",
      "!app/globals.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useImportType": "error",
        "noNonNullAssertion": "warn"
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "correctness": {
        "useExhaustiveDependencies": "warn"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "jsxQuoteStyle": "double"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "app/(salon)/**",
        "app/carta/**",
        "app/c/**",
        "app/m/**",
        "app/r/**",
        "app/v/**",
        "app/l/**",
        "app/p/**",
        "app/print/**",
        "app/capture/**",
        "components/shell/salon/**",
        "components/public-links/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/components/ui", "@/components/ui/**"],
                    "message": "Superficie congelada: importá de @/components/ui-legacy"
                  },
                  {
                    "group": [
                      "@/app/(manager)",
                      "@/app/(manager)/**",
                      "@/components/reservations/**",
                      "@/components/loyalty/**",
                      "@/components/floor-plan/**"
                    ],
                    "message": "Superficie congelada: no importes vistas del panel; usá su copia de @/components/legacy (ver components/legacy/README.md)"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "app/*/**",
        "components/**",
        "lib/**",
        "!app/(salon)/**",
        "!app/carta/**",
        "!app/c/**",
        "!app/m/**",
        "!app/r/**",
        "!app/v/**",
        "!app/l/**",
        "!app/p/**",
        "!app/print/**",
        "!app/capture/**",
        "!components/shell/salon/**",
        "!components/public-links/**",
        "!components/legacy/**",
        "!components/ui-legacy/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/components/ui-legacy",
                      "@/components/ui-legacy/**",
                      "@/components/legacy",
                      "@/components/legacy/**"
                    ],
                    "message": "Las copias congeladas son solo del salón y lo público: en el panel importá de @/components/ui o del componente original"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
